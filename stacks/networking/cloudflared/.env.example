# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=cloudflared

# Network whose services the tunnel can reach (shared reverse-proxy network)
PROXY_NETWORK=proxy

# The tunnel token lives in ./secrets/tunnel_token (not here)

# debug | info | warn | error | fatal
TUNNEL_LOGLEVEL=info
# auto | quic | http2 (use http2 if UDP/7844 is blocked outbound)
TUNNEL_TRANSPORT_PROTOCOL=auto

# Resource limits
CLOUDFLARED_CPUS=0.5
CLOUDFLARED_MEMORY=256M
