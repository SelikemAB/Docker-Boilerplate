# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Shared reverse-proxy network (create once: docker network create proxy)
PROXY_NETWORK=proxy

# Interface the edge ports listen on. 0.0.0.0 = all interfaces.
EDGE_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_HTTP3=false

# Dashboard (HTTPS + basic auth + internal-only IP allow-list)
TRAEFIK_DASHBOARD_HOST=traefik.example.com
TRAEFIK_LOG_LEVEL=INFO

# ACME / Let's Encrypt (DNS-01 challenge)
ACME_EMAIL=admin@example.com
ACME_DNS_PROVIDER=cloudflare
# Staging CA for testing: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Runtime identity (non-root)
PUID=65532
PGID=65532

# Resource limits
TRAEFIK_CPUS=1.0
TRAEFIK_MEMORY=512M

DOCKER_SOCKET=/var/run/docker.sock
