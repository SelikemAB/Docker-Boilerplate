# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=nginx

# Traefik routing (shared reverse-proxy network)
PROXY_NETWORK=proxy
NGINX_HOST=www.example.com

# Host directory with the site content, mounted read-only
NGINX_CONTENT_PATH=./html

# Only used with compose.expose-ports.yaml (loopback by default)
BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080

# Resource limits
NGINX_CPUS=0.5
NGINX_MEMORY=128M
