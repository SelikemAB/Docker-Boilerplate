# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Public hostname (DNS -> this host). Must match the host in secrets/netbird_config.yaml.
NETBIRD_HOST=netbird.example.com

# Shared reverse-proxy network of the traefik stack
PROXY_NETWORK=proxy

# STUN (UDP) for NAT traversal. 0.0.0.0 = all interfaces.
EDGE_BIND_ADDRESS=0.0.0.0
# Peers are told to use 3478 (stunPorts in the config); only change it together with that.
STUN_PORT=3478

# Server config incl. secrets lives in ./secrets/netbird_config.yaml (not here)

# Runtime identity of netbird-server (non-root)
PUID=65532
PGID=65532

# Resource limits
NETBIRD_CPUS=2.0
NETBIRD_MEMORY=1G
DASHBOARD_CPUS=0.5
DASHBOARD_MEMORY=256M
