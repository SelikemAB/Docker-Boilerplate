# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=caddy

# Interface the edge ports listen on. 0.0.0.0 = all interfaces.
EDGE_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Network that upstream containers join so Caddy can proxy to them
CADDY_NETWORK=caddy

# ACME account e-mail (Let's Encrypt / ZeroSSL expiry notices)
ACME_EMAIL=admin@example.com

# Static site (config/webserver.caddy). Public DNS name -> automatic HTTPS.
CADDY_SITE_ADDRESS=www.example.com
# Host directory with the site content, mounted read-only at /srv
CADDY_SITE_PATH=./site

# Only used with compose.nfs.yaml
NFS_SERVER=192.0.2.1
NFS_PATH=/path/to/export
NFS_OPTIONS=ro,nolock,soft

# Runtime identity (non-root)
PUID=65532
PGID=65532

# Resource limits
CADDY_CPUS=1.0
CADDY_MEMORY=512M
