# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=teleport

# Public cluster hostname. Must match cluster_name/public_addr/rp_id in config/teleport.yaml.
# Wildcard DNS (*.TELEPORT_PUBLIC_HOST) is needed for Application Access.
TELEPORT_PUBLIC_HOST=teleport.example.com

# Shared reverse-proxy network of the traefik stack
PROXY_NETWORK=proxy

# Only used with compose.expose-ports.yaml (loopback by default)
BIND_ADDRESS=127.0.0.1
TELEPORT_WEB_PORT=3080
TELEPORT_AUTH_PORT=3025

# Resource limits
TELEPORT_CPUS=2.0
TELEPORT_MEMORY=2G
