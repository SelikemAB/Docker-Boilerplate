# Copy to .env and adjust. Never commit .env; chmod 600 .env (it holds the connector tokens).
TZ=UTC
CONTAINER_NAME=twingate-connector
CONNECTOR_HOSTNAME=twingate-connector

# Tenant name: <TWINGATE_NETWORK>.twingate.com
TWINGATE_NETWORK=your-tenant

# Connector tokens from Admin Console -> Remote Networks -> Connector -> Docker.
# The image has no *_FILE support, so they must live here.
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=

# Connector log verbosity (7 = debug, for troubleshooting only)
TWINGATE_LOG_LEVEL=1

# Docker network the connector runs on (attach it to networks with Resources as needed)
TWINGATE_DOCKER_NETWORK=twingate

# Resource limits / reservations
CONNECTOR_CPUS=1.0
CONNECTOR_MEMORY=1G
CONNECTOR_CPUS_RESERVATION=0.25
CONNECTOR_MEMORY_RESERVATION=512M
