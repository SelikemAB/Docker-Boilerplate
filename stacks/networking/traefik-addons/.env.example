# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=whoami

# Shared reverse-proxy network of the traefik stack
PROXY_NETWORK=proxy

# Test route for the addon middlewares
WHOAMI_HOST=whoami.example.com
# Chain to test: default-secured@file | internal-secured@file | sso-secured@file |
# dashboard-secured@file | crowdsec-secured@file (after enabling CrowdSec)
WHOAMI_MIDDLEWARES=internal-secured@file

# Resource limits
WHOAMI_CPUS=0.1
WHOAMI_MEMORY=32M
