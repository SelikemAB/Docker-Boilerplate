# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=forgejo

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname served by Traefik (also used for SSH clone URLs)
FORGEJO_HOST=git.example.com

# Git over SSH. 0.0.0.0 = all interfaces (clients must reach it).
SSH_BIND_ADDRESS=0.0.0.0
FORGEJO_SSH_PORT=2222

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
FORGEJO_HTTP_PORT=3000
FORGEJO_ROOT_URL=http://localhost:3000/

# Behaviour
FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_REQUIRE_SIGNIN_VIEW=false
FORGEJO_LANDING_PAGE=login
FORGEJO_LOG_LEVEL=Info

# Database (password lives in ./secrets/forgejo_db_password)
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo

# Resource limits
FORGEJO_CPUS=2.0
FORGEJO_MEMORY=2G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
