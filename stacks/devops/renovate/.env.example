# Copy to .env, then: chmod 600 .env. Never commit .env.
# Renovate CE has no *_FILE support, so its credentials live here (see README).
TZ=UTC
CONTAINER_NAME=renovate

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy
# Hostname the Git platform sends webhooks to: https://RENOVATE_HOST/webhook
RENOVATE_HOST=renovate.example.com

# Set to y after reading https://www.mend.io/terms-of-service/
MEND_RNV_ACCEPT_TOS=
# Free CE license key: https://www.mend.io/renovate-community/
MEND_RNV_LICENSE_KEY=
# GitLab PAT of the Renovate bot user (scopes: api, read_user, write_repository)
MEND_RNV_GITLAB_PAT=
# Generate with: openssl rand -hex 32  (configure the same value in the GitLab webhook)
MEND_RNV_WEBHOOK_SECRET=

RENOVATE_PLATFORM=gitlab
# API endpoint incl. trailing slash, e.g. https://gitlab.example.com/api/v4/
RENOVATE_ENDPOINT=https://gitlab.com/api/v4/
RENOVATE_AUTODISCOVER=false
# debug | info | warn | error
RENOVATE_LOG_LEVEL=info

# Resource limits
RENOVATE_CPUS=2.0
RENOVATE_MEMORY=4G
