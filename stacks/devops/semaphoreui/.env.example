# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=semaphoreui

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy
SEMAPHORE_HOST=semaphore.example.com

# Initial admin (password lives in ./secrets/semaphore_admin_password)
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Administrator
SEMAPHORE_ADMIN_EMAIL=admin@example.com

# Verify SSH host keys of managed hosts (True recommended; False = template default behaviour)
ANSIBLE_HOST_KEY_CHECKING=True

# Database (password lives in ./secrets/semaphore_db_password)
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_DB_USER=semaphore

# Resource limits
SEMAPHORE_CPUS=2.0
SEMAPHORE_MEMORY=2G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
