# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=gitlab-runner

# GitLab instance URL (the runner token lives in ./secrets/gitlab_runner_token)
GITLAB_URL=https://gitlab.example.com
RUNNER_NAME=gitlab-runner
RUNNER_CONCURRENT=4
# Default image for jobs that don't specify one (pinned, never :latest)
RUNNER_EXECUTOR_IMAGE=docker.io/library/alpine:3.24.2
# true only if you need docker:dind; gives jobs root on the host
RUNNER_PRIVILEGED=false

DOCKER_SOCKET=/var/run/docker.sock

# Resource limits for the runner manager process (job containers are not limited by this)
RUNNER_CPUS=1.0
RUNNER_MEMORY=512M
