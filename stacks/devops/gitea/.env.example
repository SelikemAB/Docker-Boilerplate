# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=gitea

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname served by Traefik (also used for SSH clone URLs)
GITEA_HOST=git.example.com

# Git over SSH. 0.0.0.0 = all interfaces (clients must reach it).
SSH_BIND_ADDRESS=0.0.0.0
GITEA_SSH_PORT=2221

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
GITEA_HTTP_PORT=3000
GITEA_ROOT_URL=http://localhost:3000/

# Behaviour
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_LANDING_PAGE=login
GITEA_LOG_LEVEL=Info

# Database (password lives in ./secrets/gitea_db_password)
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea

# Resource limits
GITEA_CPUS=2.0
GITEA_MEMORY=2G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
