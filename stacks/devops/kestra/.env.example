# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=kestra

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy
# Public hostname (UI internal-only; execution webhooks public)
KESTRA_HOST=kestra.example.com

# UI/API basic-auth user, must be an e-mail address
# (password lives in ./secrets/kestra_admin_password)
KESTRA_ADMIN_USER=admin@example.com

# Worker threads of the standalone server (upstream default: 8 x CPUs)
KESTRA_WORKER_THREADS=128
KESTRA_TUTORIAL_FLOWS=false

# Database (password lives in ./secrets/kestra_db_password)
KESTRA_DB_NAME=kestra
KESTRA_DB_USER=kestra

DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
KESTRA_CPUS=2.0
KESTRA_MEMORY=4G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=2G
