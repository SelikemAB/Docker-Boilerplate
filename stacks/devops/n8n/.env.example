# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=n8n

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy
# Public hostname (editor internal-only; /webhook/ and /form/ public)
N8N_HOST=n8n.example.com

# debug | info | warn | error
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
# Execution history retention in hours (336 = 14 days)
N8N_EXECUTIONS_MAX_AGE_HOURS=336

# Database (password lives in ./secrets/n8n_db_password)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n

# Resource limits
N8N_CPUS=2.0
N8N_MEMORY=2G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
