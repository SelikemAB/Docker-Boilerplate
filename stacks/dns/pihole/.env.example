# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=pihole
PIHOLE_HOSTNAME=pihole

# Web UI (https://<host>/admin) via Traefik
PIHOLE_HOST=pihole.example.com
PROXY_NETWORK=proxy

# DNS/NTP listeners. 0.0.0.0 = all interfaces (it's a resolver); set a LAN IP to restrict.
DNS_BIND_ADDRESS=0.0.0.0
DNS_PORT=53
NTP_PORT=123

# Upstream resolvers, semicolon-separated (Quad9: malware blocking + DNSSEC by default)
PIHOLE_DNS_UPSTREAMS=9.9.9.9;149.112.112.112

# IDs of the internal `pihole` user that owns /etc/pihole
PIHOLE_UID=1000
PIHOLE_GID=1000

# Admin password lives in ./secrets/pihole_webpassword (not here)

# Resource limits
PIHOLE_CPUS=1.0
PIHOLE_MEMORY=512M

# --- compose.expose-ports.yaml (direct web UI, no Traefik) ---
BIND_ADDRESS=127.0.0.1
PIHOLE_WEB_PORT=8080

# --- compose.macvlan.yaml (dedicated LAN IP) ---
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1
MACVLAN_IPV4_ADDRESS=192.168.1.53

# --- compose.host-network.yaml (standalone alternative, DHCP) ---
# Pi-hole listening mode on the host: local = only directly connected subnets
PIHOLE_HOST_LISTENING_MODE=local
# Web UI address:port on the host (o = optional). Keep it off :80 if Traefik runs on this host.
PIHOLE_HOST_WEBSERVER_PORT=127.0.0.1:8081o
