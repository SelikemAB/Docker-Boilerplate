# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=technitium
TECHNITIUM_HOSTNAME=technitium

# Web console + DNS-over-HTTPS (https://<host>/dns-query) via Traefik
TECHNITIUM_HOST=dns.example.com
PROXY_NETWORK=proxy

# DNS listener. 0.0.0.0 = all interfaces (it's a DNS server); set a LAN IP to restrict.
DNS_BIND_ADDRESS=0.0.0.0
DNS_PORT=53

# Server settings (applied on first start; later changes are made in the web console)
TECHNITIUM_DOMAIN=dns-server
# Allow | Deny | AllowOnlyForPrivateNetworks | UseSpecifiedNetworkACL
TECHNITIUM_RECURSION=AllowOnlyForPrivateNetworks
# Comma-separated; empty = full recursive resolution
TECHNITIUM_FORWARDERS=1.1.1.1,9.9.9.9
# Udp | Tcp | Tls | Https | HttpsJson
TECHNITIUM_FORWARDER_PROTOCOL=Udp
TECHNITIUM_ENABLE_BLOCKING=false
# Plain-HTTP DoH listener on :80 inside the container, used by the Traefik /dns-query route
TECHNITIUM_DOH=true
TECHNITIUM_LOG_LOCAL_TIME=true

# Admin password lives in ./secrets/technitium_admin_password (not here)

# Runtime identity (non-root; the .NET image's `app` user)
TECHNITIUM_UID=1654
TECHNITIUM_GID=1654

# Resource limits
TECHNITIUM_CPUS=1.0
TECHNITIUM_MEMORY=1G

# --- compose.expose-ports.yaml (direct web console, no Traefik) ---
BIND_ADDRESS=127.0.0.1
TECHNITIUM_WEB_PORT=5380

# --- compose.encrypted-dns.yaml ---
DOT_PORT=853
DOQ_PORT=853

# --- compose.macvlan.yaml (dedicated LAN IP) ---
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1
MACVLAN_IPV4_ADDRESS=192.168.1.53

# --- compose.host-network.yaml (standalone alternative, DHCP) ---
# Comma-separated addresses the web console listens on in host mode
TECHNITIUM_HOST_WEB_ADDRESSES=127.0.0.1
