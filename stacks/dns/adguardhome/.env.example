# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=adguardhome

# Web UI + DNS-over-HTTPS (https://<host>/dns-query) via Traefik
ADGUARD_HOST=dns.example.com
PROXY_NETWORK=proxy

# Plain DNS listener. 0.0.0.0 = all interfaces (it's a resolver); set a LAN IP to restrict.
DNS_BIND_ADDRESS=0.0.0.0
DNS_PORT=53

# Runtime identity (non-root; the image's "nobody" user)
ADGUARD_UID=65534
ADGUARD_GID=65534

# Resource limits
ADGUARD_CPUS=1.0
ADGUARD_MEMORY=512M

# --- compose.expose-ports.yaml (direct web UI, no Traefik) ---
BIND_ADDRESS=127.0.0.1
ADGUARD_WEB_PORT=3000

# --- compose.encrypted-dns.yaml ---
DOT_PORT=853
DOQ_PORT=853
DNSCRYPT_PORT=5443

# --- compose.macvlan.yaml (dedicated LAN IP) ---
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1
MACVLAN_IPV4_ADDRESS=192.168.1.53

# --- compose.host-network.yaml (standalone alternative, DHCP) ---
# Where the web UI listens on the host. Keep it on loopback or a management IP.
ADGUARD_HOST_HTTP_ADDRESS=127.0.0.1:3000
