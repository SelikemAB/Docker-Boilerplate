; Seed zone file for home.arpa. Copied into the bind9-zones volume on FIRST start only;
; afterwards edit it in the volume (or use nsupdate with the TSIG key) and bump the serial.
$TTL 86400
@ IN SOA ns1.home.arpa. admin.home.arpa. (
  2026010101 ; serial
  3600       ; refresh
  900        ; retry
  604800     ; expire
  86400      ; minimum
)

@   IN NS ns1.home.arpa.
; Replace with the address clients use to reach this server.
ns1 IN A 127.0.0.1
