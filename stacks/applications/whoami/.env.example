# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=whoami

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik (HTTPS on the websecure entrypoint)
WHOAMI_HOST=whoami.example.com

# Container hostname and the name echoed back in every response
WHOAMI_HOSTNAME=whoami
WHOAMI_NAME=whoami

# Resource limits
WHOAMI_CPUS=0.25
WHOAMI_MEMORY=32M
