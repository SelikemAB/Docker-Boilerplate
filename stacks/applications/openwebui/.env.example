# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=openwebui
OPENWEBUI_HOSTNAME=openwebui

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik. Also used for WEBUI_URL (links, OAuth callbacks).
OPENWEBUI_HOST=openwebui.example.com

# LLM backend. Default matches compose.ollama.yaml; point it at an external Ollama otherwise.
OLLAMA_BASE_URL=http://ollama:11434

# Sign-up. The first account becomes admin; later sign-ups get DEFAULT_USER_ROLE.
# Both are persisted in the DB after first start (change them in Admin > Settings afterwards).
OPENWEBUI_ENABLE_SIGNUP=true
OPENWEBUI_DEFAULT_USER_ROLE=pending

# Resource limits
OPENWEBUI_CPUS=2.0
OPENWEBUI_MEMORY=4G

# --- compose.ollama.yaml ---
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CPUS=4.0
OLLAMA_MEMORY=16G

# --- compose.oidc.yaml (authentik or any OIDC provider) ---
OAUTH_PROVIDER_NAME=authentik
OPENID_PROVIDER_URL=https://authentik.example.com/application/o/openwebui/.well-known/openid-configuration
OAUTH_CLIENT_ID=
# No *_FILE support upstream: keep .env chmod 600.
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid email profile
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
