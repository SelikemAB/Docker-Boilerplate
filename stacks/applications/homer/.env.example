# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=homer

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik (HTTPS on the websecure entrypoint)
HOMER_HOST=homer.example.com
# Traefik middleware chain for the router. Default: private networks only.
# Example with forward auth (authentik stack): authentik@docker,internal-only@file
HOMER_MIDDLEWARES=internal-only@file

# Set to 1 on hosts without IPv6 support in Docker
HOMER_IPV6_DISABLE=0

# Resource limits
HOMER_CPUS=0.25
HOMER_MEMORY=64M
