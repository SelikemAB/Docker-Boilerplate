# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=homepage

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik. Also used for HOMEPAGE_ALLOWED_HOSTS and the auth URL.
HOMEPAGE_HOST=homepage.example.com
# Traefik middleware chain for the router. Default: private networks only.
HOMEPAGE_MIDDLEWARES=internal-only@file

# debug | info | warn | error
HOMEPAGE_LOG_LEVEL=info

# Built-in auth gate (v2.0+). The password and cookie secret live in ./secrets/.
HOMEPAGE_AUTH_ENABLED=true
# Optional OIDC login (replaces password login when all three are set).
# Callback URI to register at the IdP: https://<HOMEPAGE_HOST>/api/auth/callback/homepage-oidc
# Homepage cannot read the client secret from a file, so it has to go here (.env is chmod 600).
HOMEPAGE_OIDC_ISSUER=
HOMEPAGE_OIDC_CLIENT_ID=
HOMEPAGE_OIDC_CLIENT_SECRET=

# Runtime identity (non-root)
PUID=1000
PGID=1000

# Resource limits
HOMEPAGE_CPUS=1.0
HOMEPAGE_MEMORY=512M

DOCKER_SOCKET=/var/run/docker.sock
