# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=netbox

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik. Also used for ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
NETBOX_HOST=netbox.example.com
# Traefik middleware chain for the router. Default: private networks only.
NETBOX_MIDDLEWARES=internal-only@file

# Database (password lives in ./secrets/db_password)
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox

# Superuser created on first start (password in ./secrets/superuser_password)
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com

# Prometheus metrics at /metrics (reachable on the internal network only; block it at Traefik)
NETBOX_METRICS_ENABLED=false
# Anonymous usage census sent to the NetBox project
NETBOX_CENSUS_REPORTING_ENABLED=false
# Granian (application server) worker processes
NETBOX_GRANIAN_WORKERS=4

# E-mail. SMTP password lives in ./secrets/email_password (empty file = no SMTP auth).
# EMAIL_USE_SSL (implicit TLS, usually 465) and EMAIL_USE_TLS (STARTTLS, usually 587) are mutually exclusive.
NETBOX_EMAIL_SERVER=localhost
NETBOX_EMAIL_PORT=25
NETBOX_EMAIL_USERNAME=
NETBOX_EMAIL_FROM=netbox@example.com
NETBOX_EMAIL_USE_SSL=false
NETBOX_EMAIL_USE_TLS=false

# Resource limits
NETBOX_CPUS=2.0
NETBOX_MEMORY=2G
NETBOX_WORKER_CPUS=1.0
NETBOX_WORKER_MEMORY=1G
NETBOX_DB_CPUS=1.0
NETBOX_DB_MEMORY=1G
