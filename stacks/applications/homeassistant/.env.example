# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=homeassistant

# Shared reverse-proxy network created by the traefik stack
PROXY_NETWORK=proxy

# Public hostname routed by Traefik (HTTPS on the websecure entrypoint)
HA_HOST=homeassistant.example.com

# Subnet(s) HA trusts for X-Forwarded-For. Must contain Traefik's address on the proxy network:
#   docker network inspect proxy -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Read at runtime by the seeded configuration.yaml (only one CIDR; edit the file for more).
HA_TRUSTED_PROXIES=172.16.0.0/12

# compose.devices.yaml: host device to pass through (prefer /dev/serial/by-id/...)
HA_SERIAL_DEVICE=/dev/ttyACM0

# Resource limits
HA_CPUS=2.0
HA_MEMORY=2G
