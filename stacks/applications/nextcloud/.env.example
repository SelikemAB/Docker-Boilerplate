# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Public hostname served by Traefik (also the trusted domain and overwrite host)
NEXTCLOUD_HOST=cloud.example.com
PROXY_NETWORK=proxy
# Space-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12 10.0.0.0/8 192.168.0.0/16

# Initial admin account (password lives in ./secrets/nextcloud_admin_password)
NEXTCLOUD_ADMIN_USER=admin

# Database (password lives in ./secrets/postgres_password)
POSTGRES_USER=nextcloud
POSTGRES_DB=nextcloud
POSTGRES_SHM_SIZE=256m

# PHP limits
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=16G

# Optional: compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
NEXTCLOUD_HTTP_PORT=8080

# Resource limits
NEXTCLOUD_CPUS=2.0
NEXTCLOUD_MEMORY=2G
NEXTCLOUD_CRON_CPUS=1.0
NEXTCLOUD_CRON_MEMORY=1G
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2G
REDIS_CPUS=0.5
REDIS_MEMORY=512M
