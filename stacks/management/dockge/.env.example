# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=dockge

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname of the UI (served by Traefik, restricted by internal-only@file)
DOCKGE_HOST=dockge.example.com

# Host directory holding the compose stacks; mounted at the same path in the container
DOCKGE_STACKS_DIR=/opt/stacks

# Host Docker socket
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
DOCKGE_CPUS=1.0
DOCKGE_MEMORY=1G

# Only with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
DOCKGE_PORT=5001
