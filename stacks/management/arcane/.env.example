# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=arcane

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname of the UI (served by Traefik, restricted by internal-only@file)
ARCANE_HOST=arcane.example.com

# Where Compose projects are stored inside the container.
# For relative bind mounts in projects, bind-mount a host path at the SAME path (see README).
ARCANE_PROJECTS_DIRECTORY=/app/data/projects

# Comma-separated CIDRs of trusted reverse proxies (e.g. the proxy network subnet)
ARCANE_TRUSTED_PROXIES=

ARCANE_ANALYTICS_DISABLED=true
ARCANE_UPDATE_CHECK_DISABLED=false
ARCANE_LOG_LEVEL=info

# Host Docker socket (mounted only into the filtered socket proxy)
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
ARCANE_CPUS=1.0
ARCANE_MEMORY=1G

# Only with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
ARCANE_PORT=3552

# Only with compose.oidc.yaml (client secret goes in secrets/arcane_oidc_client_secret)
ARCANE_OIDC_CLIENT_ID=
ARCANE_OIDC_ISSUER_URL=https://auth.example.com/application/o/arcane
ARCANE_OIDC_PROVIDER_NAME=SSO
ARCANE_OIDC_SCOPES=openid email profile groups
ARCANE_OIDC_GROUPS_CLAIM=groups
ARCANE_OIDC_ROLE_MAPPINGS=
