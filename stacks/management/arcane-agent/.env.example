# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=arcane-agent

# Arcane manager URL reachable from this host (edge mode dials out to it)
ARCANE_MANAGER_API_URL=https://arcane.example.com
# Edge transport: poll (default in Arcane's generated snippets) or auto (keeps a live tunnel)
ARCANE_EDGE_TRANSPORT=poll

ARCANE_PROJECTS_DIRECTORY=/app/data/projects
ARCANE_LOG_LEVEL=info

# Host Docker socket (mounted only into the filtered socket proxy)
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
ARCANE_AGENT_CPUS=0.5
ARCANE_AGENT_MEMORY=512M

# Only with compose.direct.yaml: set to this host's management-interface IP
BIND_ADDRESS=127.0.0.1
ARCANE_AGENT_PORT=3553
