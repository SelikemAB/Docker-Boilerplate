# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=dockhand

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname of the UI (served by Traefik, restricted by internal-only@file)
DOCKHAND_HOST=dockhand.example.com

# PostgreSQL (password lives in secrets/dockhand_db_password)
DOCKHAND_DB_USER=dockhand
DOCKHAND_DB_NAME=dockhand

# Hide the username/password form once SSO (OIDC) is configured in the UI.
# Keep false for the first deployment.
DOCKHAND_DISABLE_LOCAL_LOGIN=false

# Host path of the dockhand-data volume; only needed for stacks with relative bind mounts,
# e.g. /var/lib/docker/volumes/dockhand_dockhand-data/_data
DOCKHAND_HOST_DATA_DIR=

# Host Docker socket (mounted only into the filtered socket proxy)
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
DOCKHAND_CPUS=1.0
DOCKHAND_MEMORY=1G
DOCKHAND_DB_CPUS=1.0
DOCKHAND_DB_MEMORY=1G

# Only with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
DOCKHAND_PORT=3000
