# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=komodo
CONTAINER_HOSTNAME=komodo

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname of the UI (served by Traefik, restricted by internal-only@file)
KOMODO_HOST=komodo.example.com
KOMODO_TITLE=Komodo

# Database (password lives in secrets/komodo_db_password)
KOMODO_DATABASE_DB_NAME=komodo
KOMODO_DATABASE_USERNAME=komodo
# FerretDB option ONLY (compose.ferretdb.yaml): FerretDB cannot read secrets from files.
# Must equal the content of secrets/komodo_db_password. Leave empty for MongoDB.
KOMODO_DATABASE_PASSWORD=
MONGO_WT_CACHE_GB=0.25

# Authentication (initial admin password lives in secrets/komodo_admin_password)
KOMODO_LOCAL_AUTH=true
KOMODO_MIN_PASSWORD_LENGTH=12
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=true
KOMODO_TRANSPARENT_MODE=false
# Options: 1-hr, 12-hr, 1-day, 3-day, 1-wk, 2-wk
KOMODO_JWT_TTL=1-day

# OIDC login (PKCE; for a confidential client add KOMODO_OIDC_CLIENT_SECRET_FILE, see README)
KOMODO_OIDC_ENABLED=false
KOMODO_OIDC_PROVIDER=https://auth.example.com/application/o/komodo
KOMODO_OIDC_REDIRECT_HOST=
KOMODO_OIDC_CLIENT_ID=

# Name of the first Server (also used by the local Periphery agent to connect)
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_MONITORING_INTERVAL=15-sec
KOMODO_RESOURCE_POLL_INTERVAL=1-hr
KOMODO_LOGGING_LEVEL=info

# Resource limits
KOMODO_CPUS=1.0
KOMODO_MEMORY=1G
MONGO_CPUS=1.0
MONGO_MEMORY=1G
# FerretDB option
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
FERRETDB_CPUS=0.5
FERRETDB_MEMORY=512M

# Only with compose.periphery.yaml
DOCKER_SOCKET=/var/run/docker.sock
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_DISABLE_TERMINALS=true
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false
PERIPHERY_CPUS=2.0
PERIPHERY_MEMORY=2G

# Only with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
KOMODO_PORT=9120
