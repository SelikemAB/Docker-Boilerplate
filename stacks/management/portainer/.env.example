# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=portainer

# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Public hostname of the UI (served by Traefik, restricted by internal-only@file)
PORTAINER_HOST=portainer.example.com

# Host Docker socket
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
PORTAINER_CPUS=1.0
PORTAINER_MEMORY=512M

# Only with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
PORTAINER_HTTPS_PORT=9443

# Only with compose.edge.yaml (Edge-agent tunnel)
EDGE_BIND_ADDRESS=0.0.0.0
PORTAINER_EDGE_PORT=8000
