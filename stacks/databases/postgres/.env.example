# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=postgres

POSTGRES_USER=postgres
POSTGRES_DB=postgres
# Password lives in ./secrets/postgres_password (not here)

# Loopback by default. Set to a specific interface IP to expose on the LAN.
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_NETWORK=database

# Tuning
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_SHM_SIZE=256m

# Resource limits
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2G
