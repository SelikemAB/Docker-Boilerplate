# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=mariadb

MARIADB_DATABASE=app
MARIADB_USER=app
# Passwords live in ./secrets/mariadb_password and ./secrets/mariadb_root_password (not here)

# Loopback by default. Set to a specific interface IP to expose on the LAN.
BIND_ADDRESS=127.0.0.1
MARIADB_PORT=3306
# Shared with the postgres stack by default; both servers can live on the same network.
DATABASE_NETWORK=database

# Tuning
MARIADB_MAX_CONNECTIONS=200
MARIADB_INNODB_BUFFER_POOL_SIZE=512M

# Resource limits
MARIADB_CPUS=2.0
MARIADB_MEMORY=2G
