# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Public hostname served by Traefik (SITE_URL becomes https://INFISICAL_HOST)
INFISICAL_HOST=secrets.example.com
PROXY_NETWORK=proxy

# Database (passwords and keys live in ./secrets/, not here)
POSTGRES_USER=infisical
POSTGRES_DB=infisical

# Behaviour
INFISICAL_TELEMETRY_ENABLED=false
INFISICAL_NODE_OPTIONS=--max-old-space-size=1536

# Optional: compose.smtp.yaml (password lives in ./secrets/smtp_password)
# Port 465 uses implicit TLS automatically; 587 uses STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_ADDRESS=infisical@example.com
SMTP_FROM_NAME=Infisical
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS=false

# Optional: compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
INFISICAL_PORT=8080

# Resource limits
INFISICAL_CPUS=2.0
INFISICAL_MEMORY=2G
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
REDIS_CPUS=0.5
REDIS_MEMORY=512M
