# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Shared reverse-proxy network; bouncers on it reach LAPI at http://crowdsec:8080
PROXY_NETWORK=proxy

# Hub collections installed/updated on start (space-separated).
# For AppSec add: crowdsecurity/appsec-virtual-patching crowdsecurity/appsec-generic-rules
CROWDSEC_COLLECTIONS=crowdsecurity/linux crowdsecurity/sshd crowdsecurity/traefik

# Host log directory, mounted read-only at /var/log-host
HOST_LOG_DIR=/var/log

# Optional CrowdSec Console enrollment (one-time; clear the key after the instance is enrolled)
CROWDSEC_ENROLL_KEY=
CROWDSEC_ENROLL_INSTANCE_NAME=crowdsec
CROWDSEC_ENROLL_TAGS=

# Optional: compose.traefik-logfile.yaml
TRAEFIK_LOG_DIR=/var/log/traefik

# Optional: compose.docker-logs.yaml
DOCKER_SOCKET=/var/run/docker.sock

# Optional: compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
CROWDSEC_LAPI_PORT=8080
CROWDSEC_APPSEC_PORT=7422

# Resource limits
CROWDSEC_CPUS=1.0
CROWDSEC_MEMORY=1G
