# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Public hostname served by Traefik (APP_FULL_BASE_URL becomes https://PASSBOLT_HOST)
PASSBOLT_HOST=passbolt.example.com
PROXY_NETWORK=proxy
# Comma-separated IPs of your reverse proxies. Empty = trust X-Forwarded-* from any peer
# (acceptable because only Traefik can reach the container on the proxy network).
PASSBOLT_TRUSTED_PROXIES=

# Database (password lives in ./secrets/db_password)
DB_USER=passbolt
DB_NAME=passbolt

# SMTP (required for user invitations; password lives in ./secrets/smtp_password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_TLS=true
SMTP_FROM=passbolt@example.com
SMTP_FROM_NAME=Passbolt

# Optional: compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
PASSBOLT_HTTP_PORT=8080
PASSBOLT_HTTPS_PORT=4433

# Resource limits
PASSBOLT_CPUS=2.0
PASSBOLT_MEMORY=1G
DB_CPUS=1.0
DB_MEMORY=1G
