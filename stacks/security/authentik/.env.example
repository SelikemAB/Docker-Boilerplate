# Copy to .env and adjust. Never commit .env.
TZ=UTC

# Public hostname served by Traefik
AUTHENTIK_HOST=auth.example.com
# Shared reverse-proxy network (created by the traefik stack)
PROXY_NETWORK=proxy

# Database (password lives in ./secrets/postgres_password)
POSTGRES_USER=authentik
POSTGRES_DB=authentik

# authentik behaviour
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_ERROR_REPORTING=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_SHM_SIZE=512m

# Optional: compose.bootstrap.yaml (first start only; remove afterwards)
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# Optional: compose.smtp.yaml (password lives in ./secrets/smtp_password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=authentik@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional: compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# Optional: compose.docker-outposts.yaml
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
AUTHENTIK_SERVER_CPUS=2.0
AUTHENTIK_SERVER_MEMORY=1536M
AUTHENTIK_WORKER_CPUS=2.0
AUTHENTIK_WORKER_MEMORY=1536M
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1G
