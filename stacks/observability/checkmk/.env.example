# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=checkmk

# Shared reverse-proxy network (create once: docker network create proxy)
PROXY_NETWORK=proxy

# GUI via Traefik (internal-only allow-list). The site lives at https://<host>/<site-id>/
CHECKMK_HOST=checkmk.example.com

# Site ID (fixed after first start). Admin user is cmkadmin; password lives in ./secrets/cmk_password
CMK_SITE_ID=cmk

# Optional smart host for notification e-mails (empty = disabled; see README for extra caps)
CMK_MAIL_RELAY_HOST=

# Agent receiver and SNMP traps. Loopback by default: set to the LAN IP that agents/devices use.
CMK_BIND_ADDRESS=127.0.0.1
CMK_AGENT_PORT=8000
CMK_SNMP_TRAP_PORT=162

# Resource limits
CHECKMK_CPUS=2.0
CHECKMK_MEMORY=4G
