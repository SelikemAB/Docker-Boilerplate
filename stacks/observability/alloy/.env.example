# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=alloy

# Shared networks (create once: see README)
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# Alloy web UI via Traefik (internal-only allow-list; the UI has no login)
ALLOY_HOST=alloy.example.com

# Hostname label attached to host logs/metrics. Set to the Docker host's name.
ALLOY_HOSTNAME=docker-host

# Destinations (defaults match the loki and prometheus stacks on the monitoring network)
LOKI_URL=http://loki:3100/loki/api/v1/push
PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write

# Docker socket on the host (only the socket proxy mounts it, read-only)
DOCKER_SOCKET=/var/run/docker.sock

# Resource limits
ALLOY_CPUS=1.0
ALLOY_MEMORY=1G
