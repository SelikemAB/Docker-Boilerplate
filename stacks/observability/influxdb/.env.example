# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=influxdb

# Shared networks (create once: see README)
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# UI/API via Traefik (internal-only allow-list by default)
INFLUXDB_HOST=influxdb.example.com

# Initial setup (first start only). Password and admin token live in ./secrets/ (not here)
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_ORG=example
INFLUXDB_INIT_BUCKET=default
# Retention of the initial bucket, e.g. 30d; empty = infinite
INFLUXDB_INIT_RETENTION=
INFLUXDB_LOG_LEVEL=info

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
INFLUXDB_PORT=8086

# Resource limits
INFLUXDB_CPUS=2.0
INFLUXDB_MEMORY=2G
