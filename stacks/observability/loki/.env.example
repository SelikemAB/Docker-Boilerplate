# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=loki

# Shared networks (create once: see README)
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# Loki API via Traefik (internal-only allow-list; Loki has no built-in auth)
LOKI_HOST=loki.example.com

# Retention (Go duration, multiple of 24h). 168h = 7 days.
LOKI_RETENTION_PERIOD=168h
LOKI_INGESTION_RATE_MB=4
LOKI_INGESTION_BURST_MB=6

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
LOKI_PORT=3100

# Resource limits
LOKI_CPUS=1.0
LOKI_MEMORY=1G
