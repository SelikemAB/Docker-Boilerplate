# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=uptimekuma

# Shared reverse-proxy network (create once: docker network create proxy)
PROXY_NETWORK=proxy

# Public hostname for the UI and status pages
UPTIMEKUMA_HOST=status.example.com

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
UPTIMEKUMA_PORT=3001

# Resource limits
UPTIMEKUMA_CPUS=1.0
UPTIMEKUMA_MEMORY=1G
