# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=prometheus

# Shared networks (create once: see README)
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# Prometheus UI via Traefik (internal-only allow-list; Prometheus has no login)
PROMETHEUS_HOST=prometheus.example.com

# Retention: time (15d, 30d, 1y) and optional size cap (0B = unlimited, e.g. 50GB)
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=0B

# Only used with compose.expose-ports.yaml
BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090

# Resource limits
PROMETHEUS_CPUS=1.0
PROMETHEUS_MEMORY=2G
