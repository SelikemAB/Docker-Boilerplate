# Copy to .env and adjust. Never commit .env.
TZ=UTC
CONTAINER_NAME=grafana

# Shared networks (create once: see README)
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# Public hostname (Traefik router + GF_SERVER_ROOT_URL)
GRAFANA_HOST=grafana.example.com
GRAFANA_LOG_LEVEL=info

# Initial admin user. Password lives in ./secrets/grafana_admin_password (not here)
GRAFANA_ADMIN_USER=admin

# PostgreSQL. Password lives in ./secrets/grafana_db_password (not here)
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana

# Optional SSO (compose.authentik.yaml). Client secret lives in ./secrets/grafana_oauth_client_secret
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_SLUG=grafana
AUTHENTIK_CLIENT_ID=change-me

# Resource limits
GRAFANA_CPUS=1.0
GRAFANA_MEMORY=1G
